# Kung Fu Chess — client-side integrations.
# Copy this file to .env (git-ignored) and fill in your values.

# Which LLM provider powers the AI bot difficulty in the offline lobby.
# Options: groq (default), openai. Switching providers is this line plus the
# matching API key below — no code changes.
# LLM_PROVIDER=groq

# Groq (default provider). Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (set LLM_PROVIDER=openai). Create a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Signs the session tokens the HTTP API issues and the WebSocket server
# verifies. Both roles must be given the SAME value or a token issued by one is
# rejected by the other. Never commit a real key; in a cluster this comes from a
# Secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KFCHESS_TOKEN_SIGNING_KEY=

# Comma-separated keys that still verify but no longer sign. Set this to the
# outgoing key during a rotation so tokens already in flight keep working;
# remove it once they have all expired.
# KFCHESS_PREVIOUS_TOKEN_KEYS=

# Comma-separated addresses of ingress proxies whose X-Forwarded-For header may
# be believed. Leave empty unless something in front of the server terminates
# TLS: trusting the header from any peer makes every per-IP rate limit
# bypassable with one header.
# KFCHESS_TRUSTED_PROXIES=

# Password for the local `postgres` container in docker-compose.yml. Any
# non-empty value works; it configures a throwaway container on your own machine
# and is not a credential for anything else. Generate your own rather than
# copying another developer's:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# Shared fleet state. Every one of these is optional: leaving it unset selects
# the in-process implementation behind the same interface, which is what lets
# `pytest` run green and a developer run `python main_server.py` with no
# containers at all. Setting it selects the shared one.
# --------------------------------------------------------------------------

# Where the matchmaking queue, the seat/room directory and the ownership leases
# live. Without it, two `ws` replicas are two disjoint player populations that
# can never be matched against each other. Compose sets this for you.
# KFCHESS_REDIS_URL=redis://localhost:6379/0

# Selects the PostgreSQL adapter over SQLite. Its presence is the whole switch —
# there is no separate "which database" flag that could disagree with it. The
# schema is applied by `alembic upgrade head`, never by a starting replica.
# KFCHESS_POSTGRES_DSN=postgresql://kfchess:PASSWORD@localhost:5432/kfchess

# Where room events and finished games are published. Room events go on NATS
# core (fire-and-forget; a dropped one is repaired by the next reconciliation
# frame) and finished games on JetStream (durable, replayable). Without it,
# publishing is in-process — correct for one server, and unable to reach a
# player whose socket another replica holds.
# KFCHESS_NATS_URL=nats://localhost:4222

# Names this process in directory entries and ownership leases. Defaults to
# hostname plus a random suffix, which is right in a container (the hostname is
# the Pod name) and only worth setting when you want a stable, readable name for
# a local multi-replica run. Two processes must never share one value: that
# reads as a single instance owning everything, and makes lease handover wrong
# in a way nothing reports.
# KFCHESS_INSTANCE_ID=
